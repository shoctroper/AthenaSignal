{
  "id": "1",
  "name": "Athena Multi-Agent Pipeline (Navigator Agent Zero-API)",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 30
            }
          ]
        }
      },
      "id": "node-trigger-1",
      "name": "Schedule Trigger (30s)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "filePath": "/Volumes/Medios/Repos/AthenaSignal/ciclo/COLA.md"
      },
      "id": "node-read-cola",
      "name": "Read COLA.md",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [420, 300]
    },
    {
      "parameters": {
        "jsCode": "const content = items[0].json.data || items[0].json.fileContent || '';\nconst lines = typeof content === 'string' ? content.split('\\n') : [];\nlet nextTask = null;\nlet taskId = null;\n\nfor (const line of lines) {\n  if (line.includes('[PENDIENTE]')) {\n    nextTask = { status: 'PENDIENTE', line };\n    const match = line.match(/T-\\d{3}/);\n    if(match) taskId = match[0];\n    break;\n  }\n}\n\nif (!taskId) return []; // Stop execution if no pending tasks\n\nreturn [{ json: { task: nextTask, taskId: taskId } }];"
      },
      "id": "node-parse-cola",
      "name": "Parse Task Queue",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [640, 300]
    },
    {
      "parameters": {
        "command": "={{ 'cat << \\'EOF\\' | /Volumes/Medios/Repos/AthenaSignal/scripts/process_task_navigator.sh ' + $json.taskId + '\\n' + JSON.stringify($json.task) + '\\nEOF' }}"
      },
      "id": "node-navigator-worker",
      "name": "Navigator LLM (Playwright)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [880, 300]
    }
  ],
  "connections": {
    "Schedule Trigger (30s)": {
      "main": [
        [
          {
            "node": "Read COLA.md",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read COLA.md": {
      "main": [
        [
          {
            "node": "Parse Task Queue",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Task Queue": {
      "main": [
        [
          {
            "node": "Navigator LLM (Playwright)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
